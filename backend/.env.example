# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Use the DIRECT connection (host: db.<ref>.supabase.co).
# Do NOT use the transaction pooler URL (pooler.supabase.com) — migrations require a session connection.
# URL-encode special characters in the password.

DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- OpenAI (needed once the LLM / embedding layer is wired up) ---

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_GROUNDING_MODEL=gpt-4.1-mini
OPENAI_AGENT_REQUEST_LIMIT=20
OPENAI_AGENT_TEMPERATURE=0

# --- Retrieval (hybrid search defaults) ---

RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_TOP_K=10
RETRIEVAL_RRF_K=60
RETRIEVAL_NEIGHBOR_RADIUS=1
RETRIEVAL_FTS_CONFIG=english
RETRIEVAL_FTS_KEYWORD_MODEL=gpt-4.1-mini
RETRIEVAL_FTS_KEYWORD_MIN=3
RETRIEVAL_FTS_KEYWORD_MAX=5
RETRIEVAL_FTS_KEYWORD_FAST_PATH_TOKENS=5

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173

# --- Document upload / storage ---

# Root directory for uploaded document binaries (stored under content-hash names).
# DOCUMENT_STORAGE_DIR=./data/documents
# Upload size limit in megabytes.
MAX_UPLOAD_SIZE_MB=50

# --- OCR (scanned PDFs / images) ---

# OCR_ENABLED=false
# Engine: rapidocr (bundled; downloads models from modelscope.cn on first use),
# tesseract_cli (requires a system tesseract binary), easyocr (docling[easyocr] extra).
# OCR_ENGINE=rapidocr
# Comma-separated, engine-specific: tesseract_cli uses ISO 639-2 codes ("eng", "fas"),
# rapidocr uses language families ("ch", "en").
# OCR_LANGUAGES=eng
